{
  "name": "threejs-games",
  "private": true,
  "description": "四款纯程序生成的 Three.js 浏览器游戏（无模型、贴图、音频文件）",
  "scripts": {
    "serve": "python3 -m http.server 8000",
    "play": "node tools/play.cjs",
    "build:ocean": "node tools/build-artifact.mjs examples/ocean/index.html out/windsea.html node_modules/.bin/esbuild",
    "test:ocean": "node --test tests/ocean/*.test.mjs",
    "build:windpost": "node tools/build-artifact.mjs games/windpost/index.html out/windpost.html node_modules/.bin/esbuild"
  },
  "devDependencies": {
    "playwright": "1.63.0",
    "three": "0.170.0",
    "esbuild": "0.24.0"
  },
  "type": "module"
}
